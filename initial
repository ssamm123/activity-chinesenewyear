// Check if form is submitted
if(isset($_POST['compute'])){

    // ==============================
    // Step 2: Declare Variables
    // ==============================

    $angpao1 = $_POST['angpao1'];
    $angpao2 = $_POST['angpao2'];
    $angpao3 = $_POST['angpao3'];
    $foodExpenses = $_POST['foodExpenses'];
    $isDragonYear = isset($_POST['isDragonYear']) ? true : false;
    $luckyNumber = $_POST['luckyNumber'];

    // ==============================
    // 🧮 A. Arithmetic Operators
    // ==============================

    // Compute total Ang Pao received (+ operator)
    $totalAngPao = $angpao1 + $angpao2 + $angpao3;

    // Subtract food expenses (- operator)
    $remainingMoney = $totalAngPao - $foodExpenses;

    // Multiply remaining money by 2 if Dragon Year (* operator)
    if($isDragonYear){
        $remainingMoney = $remainingMoney * 2;
        $dragonMessage = "🐉 Dragon Bonus Applied! Money Doubled!";
    } else {
        $dragonMessage = "No Dragon Bonus this year.";
    }

    // ==============================
    // ➕ B. Assignment Operators
    // ==============================

    // Add extra bonus of 500 pesos (+= operator)
    $remainingMoney += 500;

    // Deduct transportation expense (-= operator)
    $remainingMoney -= 200;

    // ==============================
    // 🔍 C. Comparison Operators
    // ==============================

    $isRich = ($remainingMoney > 5000); // Greater than >
    $isLuckyEight = ($luckyNumber == 8); // Equal to ==
    $expensesHigher = ($foodExpenses > $totalAngPao); // >

    // ==============================
    // 🔗 D. Logical Operators
    // ==============================

    $superLucky = ($remainingMoney > 5000 && $luckyNumber == 8); // AND &&
    $luckyCondition = ($remainingMoney > 5000 || $isDragonYear); // OR ||
    $notDragon = (!$isDragonYear); // NOT !

    // ==============================
    // 🔁 E. Increment / Decrement
    // ==============================

    $luckyNumber++; // Increment ++
    $foodExpenses--; // Decrement --

}
?>

